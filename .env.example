# Password for /admin and /api/analytics
ADMIN_SECRET=change-me-to-a-long-random-string

# Inquiry form → Welcome Package auto-reply (https://resend.com)
RESEND_API_KEY=
# Verified sender, e.g. Devly <sales@devly.info>
RESEND_FROM=Devly <onboarding@resend.dev>
INQUIRE_NOTIFY_EMAIL=sales@devly.info
NEXT_PUBLIC_SITE_URL=https://work.devly.info

# Client restaurant sites allowed to send leads to /api/v1/leads.
# Format: slug:key,slug:key — keys must be 24+ random characters.
# Generate one with: openssl rand -hex 24
CLIENT_SITE_KEYS=grape:replace-with-a-long-random-key

# Signs client portal (/portal) session cookies. 32+ characters.
# Generate one with: openssl rand -hex 32
# Changing it signs every client out.
PORTAL_SESSION_SECRET=

# Railway volume mount (optional locally). Required in production for the
# client portal — without it, accounts and business info reset on every deploy.
# DATA_DIR=/data
